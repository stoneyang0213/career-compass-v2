{
	"compatibility_date": "2026-04-29",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "career-compass-v2",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},

	// ─── D1 数据库绑定 ────────────────────────────────────────
	// 本地开发: wrangler 自动建本地 SQLite 文件 (.wrangler/state/v3/d1/)
	// 远端创建: wrangler d1 create career-compass-v2 → 拿到 database_id 替换占位
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "career-compass-v2",
			"database_id": "REPLACE_WITH_REAL_ID_BEFORE_DEPLOY",
			"migrations_dir": "./migrations"
		}
	]
}
