---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="min-h-screen flex items-center justify-center px-6">
    <section class="max-w-2xl text-center space-y-8">
      <p class="text-sm tracking-widest text-gray-500 uppercase">Career Compass</p>
      <h1 class="text-5xl md:text-6xl font-semibold tracking-tight text-gray-900">
        天职探索
      </h1>
      <p class="text-lg text-gray-600 leading-relaxed">
        基于 MBTI、霍兰德、舒伯职业价值观三大经典测评<br />
        加 AI 深度分析，35–45 分钟生成你的专属职业规划报告
      </p>
      <div class="pt-4">
        <a
          href="/start"
          class="inline-block px-8 py-4 bg-gray-900 text-white text-base font-medium rounded-full hover:bg-gray-800 transition"
        >
          开始测评
        </a>
        <p class="text-xs text-gray-400 mt-4">免费内测中 · 165 题 · 25 分钟可断点续填</p>
      </div>
    </section>
  </main>
</BaseLayout>
