---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="测评完成 · 天职探索">
  <main class="min-h-screen flex items-center justify-center px-6">
    <section class="max-w-2xl text-center space-y-8">
      <div class="w-20 h-20 mx-auto rounded-full bg-gray-900 flex items-center justify-center text-white text-3xl">
        ✓
      </div>
      <div>
        <p class="text-sm tracking-widest text-gray-500 uppercase mb-2">All Done</p>
        <h1 class="text-4xl font-semibold text-gray-900 tracking-tight">所有测评已完成</h1>
        <p class="text-base text-gray-600 mt-4 leading-relaxed">
          基本信息 · 当前情境 · MBTI · 霍兰德 · 舒伯 · 四维自述<br />
          全部到位，可以让 AI 开始为你生成深度职业规划报告
        </p>
      </div>

      <div class="pt-4">
        <button
          id="generate-btn"
          type="button"
          class="px-10 py-4 bg-gray-900 text-white text-base font-medium rounded-full hover:bg-gray-800 transition"
        >
          生成我的职业规划报告
        </button>
        <p class="text-xs text-gray-400 mt-4">生成约需 2-5 分钟（AI 模型推理时间）</p>
      </div>

      <p class="text-xs text-gray-400 pt-8">
        想检查或修改某一节？
        <a href="/start" class="underline hover:text-gray-900">返回任意模块</a>
      </p>
    </section>
  </main>
</BaseLayout>

<script>
  import { store } from "../lib/store";

  const btn = document.getElementById("generate-btn") as HTMLButtonElement | null;
  btn?.addEventListener("click", async () => {
    const profile = store.load();
    if (!profile) {
      alert("找不到本地测评数据，请重新开始");
      return;
    }
    btn.disabled = true;
    btn.textContent = "提交中…";
    try {
      const resp = await fetch("/api/generate", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(profile)
      });
      const data = await resp.json();
      if (!resp.ok) {
        alert(`生成失败: ${data.error ?? resp.status}\n${JSON.stringify(data, null, 2)}`);
        btn.disabled = false;
        btn.textContent = "生成我的职业规划报告";
        return;
      }
      window.location.assign(`/generating?id=${data.reportId}`);
    } catch (e) {
      alert(`网络错误: ${e instanceof Error ? e.message : String(e)}`);
      btn.disabled = false;
      btn.textContent = "生成我的职业规划报告";
    }
  });
</script>
