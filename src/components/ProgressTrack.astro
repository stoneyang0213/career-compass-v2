---
import { MODULES } from "../lib/modules";
import type { ModuleId } from "../lib/types";

interface Props {
  current: ModuleId;
  completed: ModuleId[];
}

const { current, completed } = Astro.props;
const completedCount = completed.length;
const total = MODULES.length;
const percent = Math.round((completedCount / total) * 100);
---

<nav class="w-full">
  <div class="flex items-center justify-between mb-3">
    <span class="text-xs tracking-widest text-gray-500 uppercase">
      第 {MODULES.findIndex((m) => m.id === current) + 1} / {total} 步
    </span>
    <span class="text-xs text-gray-500">已完成 {completedCount}/{total} 个模块</span>
  </div>
  <div class="bg-gray-100 rounded-full h-1.5 overflow-hidden">
    <div
      class="bg-gray-900 h-1.5 rounded-full transition-all duration-500 ease-out"
      style={`width: ${percent}%`}
    ></div>
  </div>
  <ol class="grid grid-cols-6 gap-1 mt-3 text-[10px] text-gray-400">
    {MODULES.map((m) => (
      <li
        class:list={[
          "text-center truncate",
          completed.includes(m.id) && "text-gray-900 font-medium",
          m.id === current && "text-gray-900 font-semibold"
        ]}
      >
        {m.title}
      </li>
    ))}
  </ol>
</nav>
